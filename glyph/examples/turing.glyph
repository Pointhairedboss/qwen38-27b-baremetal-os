; turing.glyph — a Turing machine simulator written in Glyph.
;
;   glyph run examples/turing.glyph
;
; The transition table is data (three arrays indexed by state and symbol),
; so the same Glyph code runs any 2-symbol machine with up to 4 states.
; Buttons load the classic busy-beaver champions (2, 3 and 4 states), then
; Step executes one transition and Run runs to the halt state.
; Expected (independent Python reference, tests/reference/check_tc.py):
;   BB-2: 6 steps, 4 ones   BB-3: 14 steps, 6 ones   BB-4: 107 steps, 13 ones

SCREEN 80 14

ARRAY tape 80          ; cell i is ITEM tape i, i = 1..80
ARRAY wr 8             ; per (state, symbol): symbol to write
ARRAY mv 8             ; head move: 1 = right, -1 = left
ARRAY nx 8             ; next state: 1..4 = A..D, 0 = halt

SET head 40
SET state 0
SET steps 0
SET ones 0
SET sname "-"
SET machine "none"
SET status ""

PANEL top 0 0 80 7 "Turing machine in Glyph"
LABEL l1 2 1 "machine:"
LABEL lm 11 1 :machine
LABEL l2 40 1 "state:"
LABEL ls 47 1 :sname
LABEL l3 53 1 "steps:"
LABEL tval 60 1 :steps
LABEL l4 67 1 "ones:"
LABEL lo 73 1 :ones
LABEL st 2 2 :status
BUTTON b2 2 4 "BB-2" load2
BUTTON b3 11 4 "BB-3" load3
BUTTON b4 20 4 "BB-4" load4
BUTTON bs 31 4 "Step" dostep
BUTTON br 40 4 "Run" dorun
LABEL help 50 4 "TAB, ENTER, ESC quits"

; ---- the machine ---------------------------------------------------------
TO rule :s :sym :w :m :n           ; in state s reading sym: write w, move m, go to n
  LOCAL k
  SET k (:s - 1) * 2 + :sym + 1
  SETITEM wr :k :w
  SETITEM mv :k :m
  SETITEM nx :k :n
END

TO cleartape
  LOCAL i
  SET i 1
  WHILE :i <= 80 [SETITEM tape :i 0 ADD i 1]
END

TO reset :name
  cleartape
  SET head 40 SET state 1 SET steps 0
  SET machine :name
  SET status "ready"
END

TO step
  LOCAL k
  IF :state = 0 [STOP]
  SET k (:state - 1) * 2 + (ITEM tape :head) + 1
  SETITEM tape :head ITEM wr :k
  SET head :head + ITEM mv :k
  SET state ITEM nx :k
  ADD steps 1
END

TO runall
  WHILE :state <> 0 [step]
END

; ---- display ------------------------------------------------------------------
TO countones
  LOCAL i LOCAL n
  SET i 1 SET n 0
  WHILE :i <= 80 [SET n :n + ITEM tape :i ADD i 1]
  OUTPUT :n
END

TO letter :s
  IF :s = 0 [OUTPUT "halt"]
  IF :s = 1 [OUTPUT "A"]
  IF :s = 2 [OUTPUT "B"]
  IF :s = 3 [OUTPUT "C"]
  OUTPUT "D"
END

TO show
  LOCAL i
  COLOR 7 0 RECT 0 8 80 3
  SET i 1
  WHILE :i <= 80 [
    IFELSE (ITEM tape :i) = 1 [COLOR 14 0 TEXT :i - 1 9 "1"] [COLOR 8 0 TEXT :i - 1 9 "."]
    ADD i 1
  ]
  COLOR 11 0 TEXT :head - 1 10 "^"
  COLOR 7 0
  SET ones countones
  SET sname letter :state
  IF :state = 0 [SET status WORD "halted after " WORD :steps " steps"]
END

; ---- the three busy beavers -----------------------------------------------------
TO bb2
  reset "2-state busy beaver"
  rule 1 0 1 1 2  rule 1 1 1 -1 2
  rule 2 0 1 -1 1 rule 2 1 1 1 0
END
TO bb3
  reset "3-state busy beaver"
  rule 1 0 1 1 2  rule 1 1 1 1 0
  rule 2 0 0 1 3  rule 2 1 1 1 2
  rule 3 0 1 -1 3 rule 3 1 1 -1 1
END
TO bb4
  reset "4-state busy beaver"
  rule 1 0 1 1 2  rule 1 1 1 -1 2
  rule 2 0 1 -1 1 rule 2 1 0 -1 3
  rule 3 0 1 1 0  rule 3 1 1 -1 4
  rule 4 0 1 1 4  rule 4 1 0 1 1
END

ON load2 [bb2 show]
ON load3 [bb3 show]
ON load4 [bb4 show]
ON dostep [step show]
ON dorun [runall show]

bb4
show
