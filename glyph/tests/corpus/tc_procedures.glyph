; Procedures with inputs, OUTPUT and recursion. Values are checked against
; Python by tests/reference/check_tc.py.
SCREEN 10 2
TO fib :n
  IF :n < 2 [OUTPUT :n]
  OUTPUT (fib :n - 1) + (fib :n - 2)
END
TO fact :n
  IF :n = 0 [OUTPUT 1]
  OUTPUT :n * fact :n - 1
END
TO hanoi :n :src :dst :tmp        ; number of moves for n discs
  IF :n = 0 [OUTPUT 0]
  OUTPUT (hanoi :n - 1 :src :tmp :dst) + 1 + (hanoi :n - 1 :tmp :dst :src)
END
TO ack :m :n
  IF :m = 0 [OUTPUT :n + 1]
  IF :n = 0 [OUTPUT ack :m - 1 1]
  OUTPUT ack :m - 1 ack :m :n - 1
END
TO gcd :a :b
  WHILE :b <> 0 [LOCAL t SET t REMAINDER :a :b SET a :b SET b :t]
  OUTPUT :a
END
SET fib18 fib 18
SET fact12 fact 12
SET hanoi9 hanoi 9 1 3 2
SET ack23 ack 2 3
SET gcd gcd 1071 462
